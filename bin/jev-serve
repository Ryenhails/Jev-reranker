#!/bin/bash
# Serve autotrust/JEV-27B-VL (System 1 decisions at POST /v1/decide, System 2 chat) with the vLLM 0.30.0 image.
#
#   VLLM_API_KEY=<token> jev-serve <port> [extra vllm args...]
#
# Flags follow the model's own serve.sh (revision fee8c1d): LoRA "jev-decision" = backbone LoRA + decision head,
# processed logprobs, prefix caching, mamba align mode, --max-num-seqs 8 (larger batches give wrong System 1
# probabilities on this model class). serve_decide.py is the model repo's script (standard vLLM OpenAI server
# plus the /v1/decide route); it was read before use.
#
#   VLLM_SIF   Apptainer image built from docker://vllm/vllm-openai:v0.30.0 (required)
#   HF_HOME    Hugging Face cache that holds JEV-27B-VL revision fee8c1d (default ~/.cache/huggingface)
set -euo pipefail
: "${VLLM_SIF:?set VLLM_SIF to the vllm-openai v0.30.0 image}"
HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
SNAP=$HF_HOME/hub/models--autotrust--JEV-27B-VL/snapshots/fee8c1d19d60216f8e9bcbb348141c0aa87ee2cc
PORT=$1; shift
: "${VLLM_API_KEY:?set VLLM_API_KEY}"
LOCAL=/tmp/${USER}_jev_${SLURM_JOB_ID:-x}
VHOME=$LOCAL/home
mkdir -p "$VHOME" "$LOCAL/cache" "$LOCAL/tmp"
command -v apptainer >/dev/null 2>&1 || module load apptainer

export HF_HOME HF_HUB_OFFLINE=1
export HF_HUB_CACHE=$HF_HOME/hub HUGGINGFACE_HUB_CACHE=$HF_HOME/hub TRANSFORMERS_CACHE=$HF_HOME/hub
export XDG_CACHE_HOME=$LOCAL/cache VLLM_CACHE_ROOT=$LOCAL/cache/vllm
export TRITON_CACHE_DIR=$LOCAL/cache/triton TORCHINDUCTOR_CACHE_DIR=$LOCAL/cache/inductor
export TMPDIR=$LOCAL/tmp
# host compiler-module variables break the image's gcc
unset CC CXX FC F77 GCC_ROOT GCC_RUNTIME_ROOT CPATH LIBRARY_PATH

exec apptainer exec --nv \
    --home "$VHOME" \
    --bind "$HF_HOME" --bind "$LOCAL" \
    "$VLLM_SIF" \
    python3 "$SNAP/serve_decide.py" --model "$SNAP" --served-model-name autotrust/JEV-27B-VL \
    --host 127.0.0.1 --port "$PORT" \
    --enable-lora --max-lora-rank 32 --lora-modules jev-decision="$SNAP/adapter_vllm" \
    --logprobs-mode processed_logprobs --max-model-len "${MAX_MODEL_LEN:-32768}" --enable-prefix-caching \
    --mamba-cache-mode align --limit-mm-per-prompt '{"image": 8}' --max-num-seqs 8 --trust-request-chat-template \
    "$@"
